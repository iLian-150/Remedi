# 服务器 /remedi/.env；填写真实配置后保持该文件仅服务器可读，不提交 Git。
COMPOSE_PROJECT_NAME=remedi
COMPOSE_FILE=docker-compose.yml:docker-compose.milvus.yml
WEB_PORT=5001
API_PORT=5000
APP_TIMEZONE=Asia/Shanghai
# 部分云主机构建容器无法解析 DNS 时使用 host；不改变运行时容器网络。
BUILD_NETWORK=host
SEED_DEMO_DATA=false
LLM_PROVIDER=openai-compatible
LLM_TIMEOUT_SECONDS=120
# 对话与视觉模型使用 AI Ping；真实 Key 仅填写在服务器 /remedi/.env。
LLM_API_KEY=
LLM_BASE_URL=https://aiping.cn/api/v1
LLM_MODEL=GLM-5.3-Flash
LLM_VISION_MODEL=GLM-5.3-Flash
# DashScope 变量仅用于旧部署兼容；新配置由上方 AI Ping 设置统一提供。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 旧版聊天配置回退值。
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_VISION_MODEL=qwen3.8-flash
RAG_API_KEY=
RAG_BASE_URL=
RAG_MILVUS_COLLECTION=remedi_subject_knowledge_qwen3_embedding4b
RAG_MILVUS_TOKEN=
RAG_EMBEDDING_MODEL=Qwen3-Embedding-4B
RAG_EMBEDDING_DIMENSIONS=1024
RAG_TIMEOUT_SECONDS=8
RAG_RERANK_MODEL=Qwen3-Reranker-0.6B
RAG_RERANK_TIMEOUT_SECONDS=10
# 扫描文字使用本地 OCR；原生部署可改为 /remedi/runtime/ocr/bin/tesseract。
RAG_OCR_EXECUTABLE=tesseract
RAG_OCR_LANGUAGE=chi_sim+eng
RAG_OCR_DPI=200
RAG_OCR_WORKERS=2
RAG_OCR_TIMEOUT_SECONDS=90
RAG_VISUAL_ENABLED=true
RAG_VISUAL_TIMEOUT_SECONDS=45
RAG_MINIO_ROOT_USER=remedi-rag
RAG_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
